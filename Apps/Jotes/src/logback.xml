<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs do Jotes: consola (WARN+) e ficheiro diário em ${jotes.log.dir}/jotes.log,
  guardando 14 dias. A propriedade é definida por jotes.util.Log#init no arranque;
  se faltar, cai em ./data/logs.
-->
<configuration>
  <property name="LOG_DIR" value="${jotes.log.dir:-data/logs}"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss} %-5level %logger{24} - %msg%n</pattern>
    </encoder>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>WARN</level>
    </filter>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/jotes.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/jotes.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>14</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- bibliotecas verbosas: só avisos, senão o ficheiro enche-se de DEBUG delas -->
  <logger name="org.apache" level="WARN"/>
  <logger name="org.fife" level="WARN"/>
  <logger name="com.vladsch" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
